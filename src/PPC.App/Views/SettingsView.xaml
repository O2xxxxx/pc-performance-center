<UserControl x:Class="Ppc.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 开关：轨道 + 圆点，全部颜色走 DynamicResource -->
        <Style x:Key="SwitchToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="40" Height="21" CornerRadius="11"
                                    Background="{DynamicResource Bg.Hover}"
                                    BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="15" Height="15"
                                         Fill="{DynamicResource Text.Tertiary}"
                                         HorizontalAlignment="Left" Margin="2,0,0,0" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Bg.Window}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置项一行：左侧标题 + 说明，右侧控件 -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,7" />
        </Style>

        <!-- 能力矩阵一行：标题 + 说明 + 支持/不支持徽标 -->
        <DataTemplate x:Key="CapabilityRowTemplate">
            <Border BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="2,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border x:Name="Badge" Grid.Column="1" CornerRadius="8" Padding="9,3"
                            Background="{DynamicResource Accent.Soft}" VerticalAlignment="Center">
                        <TextBlock x:Name="BadgeText" Text="支持" Style="{StaticResource HintText}"
                                   Foreground="{DynamicResource Accent.Primary}" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Supported}" Value="False">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Bg.Hover}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="不支持" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource State.Muted}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,18,22,22">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- 常规与外观 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="常规与外观" Style="{StaticResource SectionTitleText}" />

                    <Grid Style="{StaticResource SettingRow}" Margin="0,12,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="主题" Style="{StaticResource BodyText}" Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock Text="立即生效并写入设置文件" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="深色" Command="{Binding SetThemeCommand}" CommandParameter="Dark" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Theme}" Value="Dark">
                                                <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="浅色" Command="{Binding SetThemeCommand}" CommandParameter="Light">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Theme}" Value="Light">
                                                <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="界面语言" Style="{StaticResource BodyText}" Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock Text="当前版本仅提供简体中文界面" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Language}" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Border.Subtle}" Margin="0,10,0,4" />

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="开机启动" Style="{StaticResource BodyText}" Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock Text="{Binding StartupMessage}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="最小化到托盘" Style="{StaticResource BodyText}" Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock Text="关闭或最小化窗口时保留后台采样" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="退出时恢复默认策略" Style="{StaticResource BodyText}" Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock Text="退出前把电源方案与风扇控制交还系统，避免机器停在自定义状态" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                  IsChecked="{Binding RestoreOnExit, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="显示不可用项" Style="{StaticResource BodyText}" Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock Text="关闭后，监控页会隐藏本机读不到的传感器" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowUnavailableMetrics, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 数据与历史 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="数据与历史" Style="{StaticResource SectionTitleText}" />

                    <Grid Style="{StaticResource SettingRow}" Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="历史窗口" Style="{StaticResource BodyText}" Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock Text="曲线保留的时间长度，保存时按「窗口 ÷ 采样间隔」重建历史缓冲" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyText}"
                                   Text="{Binding HistoryWindowSeconds, StringFormat={}{0} 秒}" />
                    </Grid>
                    <Slider Minimum="60" Maximum="3600" SmallChange="30" LargeChange="300" TickFrequency="60"
                            IsSnapToTickEnabled="False" Style="{StaticResource ModernSlider}"
                            Value="{Binding HistoryWindowSeconds, Mode=TwoWay}" />

                    <Border Height="1" Background="{DynamicResource Border.Subtle}" Margin="0,12,0,4" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="设置文件" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SettingsFilePath}" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="数据目录" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DataDirectory}" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="打开" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenDataDirectoryCommand}" Padding="12,6" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="日志文件" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding LogPath}" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="打开日志目录" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenLogCommand}" Padding="12,6" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 设备信息 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="设备信息" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource BodyText}" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding BiosText}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="序列号" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Grid.Column="1" Text="{Binding SerialText}" Style="{StaticResource BodyText}" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="处理器" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource BodyText}" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="显卡" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Grid.Column="1" Text="{Binding GpuText}" Style="{StaticResource BodyText}" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="内存" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Grid.Column="1" Text="{Binding MemoryText}" Style="{StaticResource BodyText}" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="操作系统" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Grid.Column="1" Text="{Binding OsText}" Style="{StaticResource BodyText}" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="平台标识" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Grid.Column="1" Text="{Binding PlatformText}" Style="{StaticResource BodyText}" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="权限" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Grid.Column="1" Text="{Binding ElevationText}" Style="{StaticResource BodyText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 能力矩阵 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="能力矩阵" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding AppVersion, StringFormat=版本 {0}}" Style="{StaticResource HintText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding CapabilitiesText}" Style="{StaticResource HintText}" Margin="0,6,0,6" />
                    <ItemsControl ItemsSource="{Binding Capabilities}"
                                  ItemTemplate="{StaticResource CapabilityRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- 操作 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="保存与恢复" Style="{StaticResource SectionTitleText}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="保存设置" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}" Margin="0,0,8,8" />
                        <Button Content="重置设置" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ResetSettingsCommand}" Margin="0,0,8,8"
                                ToolTip="放弃未保存的修改，从设置文件重新读取" />
                        <Button Content="恢复出厂默认" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RestoreDefaultsCommand}" Margin="0,0,8,8" />
                        <Button Content="以管理员身份重启" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RestartElevatedCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SaveMessage}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
