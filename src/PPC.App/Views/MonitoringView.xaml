<UserControl x:Class="Ppc.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Ppc.App.Controls">
    <UserControl.Resources>
        <!-- 指标一行：名称 / 数值 / 单位 / 来源或不可用原因 -->
        <DataTemplate x:Key="MetricRowTemplate">
            <Border BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="2,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="130" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource HintText}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource CardTitleText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Style="{StaticResource HintText}"
                               Margin="4,0,0,0" VerticalAlignment="Center" />
                    <Ellipse Grid.Column="3" Width="7" Height="7" Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,18,22,22">
        <StackPanel>

            <!-- 采样控制 -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding SamplingText}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding BackendsText, StringFormat=活动后端：{0}}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="采样间隔" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  Width="86"
                                  ItemsSource="{Binding IntervalOptions}"
                                  SelectedItem="{Binding RefreshIntervalSeconds, Mode=TwoWay}"
                                  ToolTip="切换后立即重启监控采样" />
                        <TextBlock Text="秒" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="立即刷新" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="清空历史" Style="{StaticResource GhostButton}"
                            Command="{Binding ClearHistoryCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Margin="0,8,0,0">
                <TextBlock Text="{Binding HistoryMessage}" Style="{StaticResource HintText}" />
                <TextBlock Text="{Binding MetricCountText}" Style="{StaticResource HintText}" HorizontalAlignment="Right" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="1.1*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- 全部指标 -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="全部指标" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource HintText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="640">
                            <ItemsControl ItemsSource="{Binding AllMetrics}"
                                          ItemTemplate="{StaticResource MetricRowTemplate}"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 三张历史曲线 -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="温度历史（°C）" Style="{StaticResource SectionTitleText}" />
                            <controls:LineChart Series="{Binding TemperatureChartSeries}" Unit="°C"
                                                FixedMin="20" FixedMax="110" ShowGrid="True" ShowLegend="True"
                                                Height="188" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="使用率历史（%）" Style="{StaticResource SectionTitleText}" />
                            <controls:LineChart Series="{Binding UsageChartSeries}" Unit="%"
                                                FixedMin="0" FixedMax="100" ShowGrid="True" ShowLegend="True"
                                                Height="188" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="功耗历史（W）" Style="{StaticResource SectionTitleText}" />
                            <controls:LineChart Series="{Binding PowerChartSeries}" Unit="W"
                                                ShowGrid="True" ShowLegend="True" AutoScale="True"
                                                Height="188" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
