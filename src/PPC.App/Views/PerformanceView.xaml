<UserControl x:Class="Ppc.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1120">

    <UserControl.Resources>
        <!-- 模式卡片：选中态用强调色描边 + 渐变柔光，点击即触发 SelectModeCommand -->
        <Style x:Key="ModeCardRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Background="{DynamicResource Bg.SurfaceAlt}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="12" Padding="16,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="1.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,12">

            <!-- 页头 -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel />
                <Button Grid.Column="1" Content="刷新状态" Command="{Binding RefreshCommand}"
                        Style="{DynamicResource SecondaryButton}" VerticalAlignment="Center" MinWidth="96" />
            </Grid>

            <!-- 四张模式卡 -->
            <UniformGrid Columns="4">
                <RadioButton Style="{DynamicResource ModeCardRadio}" Margin="0,0,12,0" GroupName="PerfMode"
                             Command="{Binding SelectModeCommand}" CommandParameter="Eco"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Eco, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="节能" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="限制功耗与频率上限，风扇更安静" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{DynamicResource ModeCardRadio}" Margin="0,0,12,0" GroupName="PerfMode"
                             Command="{Binding SelectModeCommand}" CommandParameter="Balanced"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Balanced, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="均衡" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="默认推荐，性能与噪音平衡" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{DynamicResource ModeCardRadio}" Margin="0,0,12,0" GroupName="PerfMode"
                             Command="{Binding SelectModeCommand}" CommandParameter="Performance"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Performance, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="高性能" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="放开处理器上限，游戏与渲染优先" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{DynamicResource ModeCardRadio}" GroupName="PerfMode"
                             Command="{Binding SelectModeCommand}" CommandParameter="Custom"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Custom, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="自定义" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="自己决定处理器状态与睿频策略" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <!-- 当前状态 -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="当前电源方案" Style="{DynamicResource MetricLabelText}" />
                        <TextBlock Text="{Binding PowerPlanText}" Style="{DynamicResource BodyText}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0">
                        <TextBlock Text="当前状态摘要" Style="{DynamicResource MetricLabelText}" />
                        <TextBlock Text="{Binding CurrentSummary}" Style="{DynamicResource BodyText}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                        <TextBlock Text="联想私有性能模式" Style="{DynamicResource MetricLabelText}" />
                        <TextBlock Text="{Binding LenovoModeDetail}" Style="{DynamicResource BodyText}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 可调参数 -->
            <TextBlock Text="可调参数" Style="{DynamicResource SectionTitleText}" Margin="0,24,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,12,0"
                        IsEnabled="{Binding CanAdjust}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最大处理器状态" Style="{DynamicResource CardTitleText}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding MaxProcessorState}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent.Primary}" />
                                <TextBlock Text="%" Style="{DynamicResource MetricUnitText}" Margin="2,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Slider Style="{DynamicResource ModernSlider}" Minimum="5" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding MaxProcessorState, Mode=TwoWay}" Margin="0,10,0,0" />
                        <TextBlock Text="写入 Windows 官方设置 PROCTHROTTLEMAX，限制 CPU 最高频率百分比。"
                                   Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最小处理器状态" Style="{DynamicResource CardTitleText}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding MinProcessorState}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent.Primary}" />
                                <TextBlock Text="%" Style="{DynamicResource MetricUnitText}" Margin="2,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Slider Style="{DynamicResource ModernSlider}" Minimum="5" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding MinProcessorState, Mode=TwoWay}" Margin="0,10,0,0" />
                        <TextBlock Text="写入 PROCTHROTTLEMIN，抬高频率下限会明显增加发热与耗电。"
                                   Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource CardStyle}" IsEnabled="{Binding CanAdjust}">
                    <StackPanel>
                        <TextBlock Text="睿频策略" Style="{DynamicResource CardTitleText}" />
                        <ComboBox Style="{DynamicResource ModernComboBox}" Margin="0,10,0,0"
                                  ItemsSource="{Binding BoostOptions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedBoostMode, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="禁用 = 关闭 Turbo Boost；启用 = 允许最大睿频；高效 = 按负载动态提升。"
                                   Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <CheckBox Style="{DynamicResource ModernToggle}" Margin="0,16,0,0"
                                  Content="同时下发联想私有性能模式（GameZone WMI）"
                                  IsChecked="{Binding UseLenovoMode, Mode=TwoWay}"
                                  IsEnabled="{Binding LenovoModeSupported}" />
                        <TextBlock Text="{Binding LenovoModeDetail}" Style="{DynamicResource HintText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="应用当前设置" Command="{Binding ApplyCommand}"
                        Style="{DynamicResource PrimaryButton}" MinWidth="124" />
                <Button Content="恢复系统默认" Command="{Binding RestoreDefaultsCommand}"
                        Style="{DynamicResource SecondaryButton}" MinWidth="124" Margin="10,0,0,0" />
                <TextBlock Text="只调用 Windows 官方 powercfg 与 WMI 查询，不写 EC 寄存器、不改 BIOS。"
                           Style="{DynamicResource HintText}" VerticalAlignment="Center" Margin="16,0,0,0"
                           TextWrapping="Wrap" MaxWidth="480" />
            </StackPanel>

            <!-- 操作结果 -->
            <Border Style="{DynamicResource PanelStyle}" Margin="0,12,0,0"
                    Visibility="{Binding HasApplyMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ApplyMessage}" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{Binding ApplyState, Converter={StaticResource StateToBrush}}" />
            </Border>

            <!-- 能力与限制 -->
            <TextBlock Text="能力与限制（本机真实探测）" Style="{DynamicResource SectionTitleText}" Margin="0,24,0,10" />
            <Border Style="{DynamicResource CardStyle}">
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource State.Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Supported}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource State.Good}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}" />
                                    <TextBlock Text="{Binding Description}" Style="{DynamicResource HintText}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" MinWidth="120">
                                    <TextBlock Text="{Binding ValueText}" FontSize="11.5" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="支持" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource State.Good}"
                                               Visibility="{Binding Supported, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="不支持" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource State.Muted}"
                                               Visibility="{Binding Supported, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
