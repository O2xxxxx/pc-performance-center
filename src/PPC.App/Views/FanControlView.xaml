<UserControl x:Class="Ppc.App.Views.FanControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:Ppc.App.Controls"
             mc:Ignorable="d" d:DesignHeight="1000" d:DesignWidth="1120">

    <UserControl.Resources>
        <Style x:Key="FanModeCardRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Background="{DynamicResource Bg.SurfaceAlt}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="1.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,12">

            <!-- 页头 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新状态" Command="{Binding RefreshCommand}"
                            Style="{DynamicResource SecondaryButton}" MinWidth="96" />
                    <Button Content="恢复厂商自动" Command="{Binding RestoreAutoCommand}"
                            Style="{DynamicResource PrimaryButton}" MinWidth="120" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- 不支持直接控制时的真实原因 -->
            <Border Style="{DynamicResource CardStyle}" BorderBrush="{DynamicResource State.Warn}" Margin="0,0,0,14"
                    Visibility="{Binding IsControlUnavailable, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="本机无法直接控制风扇转速" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource State.Warn}" />
                    <TextBlock Text="{Binding SupportDetail}" Style="{DynamicResource HintText}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- 风扇状态 -->
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="风扇状态" Style="{DynamicResource CardTitleText}" />
                        <TextBlock Grid.Column="1" Text="{Binding FanCountText}" Style="{DynamicResource HintText}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding FanTiles}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource PanelStyle}" Margin="0,0,10,0" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{DynamicResource MetricLabelText}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Value}" Style="{DynamicResource MetricValueText}" />
                                            <TextBlock Text="{Binding Unit}" Style="{DynamicResource MetricUnitText}"
                                                       VerticalAlignment="Bottom" Margin="3,0,0,4" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{DynamicResource HintText}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="控制来源" Style="{DynamicResource MetricLabelText}" />
                            <TextBlock Text="{Binding ControlSourceText}" Style="{DynamicResource BodyText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="通道详情" Style="{DynamicResource MetricLabelText}" />
                            <TextBlock Text="{Binding ChannelDetailText}" Style="{DynamicResource BodyText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="实际下发转速" Style="{DynamicResource MetricLabelText}" />
                            <TextBlock Text="{Binding AppliedPercentText}" Style="{DynamicResource BodyText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="直接控制能力" Style="{DynamicResource MetricLabelText}" />
                            <TextBlock Text="{Binding SupportsControl}" Style="{DynamicResource BodyText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 控制模式 -->
            <TextBlock Text="控制模式" Style="{DynamicResource SectionTitleText}" Margin="0,24,0,10" />
            <UniformGrid Columns="5">
                <RadioButton Style="{DynamicResource FanModeCardRadio}" Margin="0,0,10,0" GroupName="FanMode"
                             IsEnabled="{Binding ModeOptions[0].Enabled}"
                             ToolTip="{Binding ModeOptions[0].DisabledReason}"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Auto, Mode=TwoWay}">
                    <StackPanel>
                        <TextBlock Text="自动" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="交给厂商/系统曲线" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{DynamicResource FanModeCardRadio}" Margin="0,0,10,0" GroupName="FanMode"
                             IsEnabled="{Binding ModeOptions[1].Enabled}"
                             ToolTip="{Binding ModeOptions[1].DisabledReason}"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Silent, Mode=TwoWay}">
                    <StackPanel>
                        <TextBlock Text="静音" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="优先低噪音" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{DynamicResource FanModeCardRadio}" Margin="0,0,10,0" GroupName="FanMode"
                             IsEnabled="{Binding ModeOptions[2].Enabled}"
                             ToolTip="{Binding ModeOptions[2].DisabledReason}"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Performance, Mode=TwoWay}">
                    <StackPanel>
                        <TextBlock Text="性能" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="优先散热" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{DynamicResource FanModeCardRadio}" Margin="0,0,10,0" GroupName="FanMode"
                             IsEnabled="{Binding ModeOptions[3].Enabled}"
                             ToolTip="{Binding ModeOptions[3].DisabledReason}"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Manual, Mode=TwoWay}">
                    <StackPanel>
                        <TextBlock Text="手动" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="固定转速" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{DynamicResource FanModeCardRadio}" GroupName="FanMode"
                             IsEnabled="{Binding ModeOptions[4].Enabled}"
                             ToolTip="{Binding ModeOptions[4].DisabledReason}"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Curve, Mode=TwoWay}">
                    <StackPanel>
                        <TextBlock Text="曲线" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="按温度曲线调速" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="应用所选模式" Command="{Binding ApplyModeCommand}"
                        Style="{DynamicResource SecondaryButton}" MinWidth="120" />
                <TextBlock Text="选好模式后点这里才会真正下发；不支持的模式无法选中。"
                           Style="{DynamicResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <!-- 手动转速 -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="手动转速" Style="{DynamicResource CardTitleText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding ManualPercent}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent.Primary}" />
                            <TextBlock Text="%" Style="{DynamicResource MetricUnitText}" Margin="2,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Slider Style="{DynamicResource ModernSlider}" Minimum="20" Maximum="100"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ManualPercent, Mode=TwoWay}"
                            IsEnabled="{Binding CanManualFan}" Margin="0,10,0,0" />
                    <TextBlock Text="安全下限 20%，任何模式下都不会下发 0%。本机不支持直接控制时滑块保持禁用。"
                               Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="应用手动转速" Command="{Binding ApplyManualCommand}"
                                Style="{DynamicResource PrimaryButton}" MinWidth="120"
                                IsEnabled="{Binding CanManualFan}" />
                        <TextBlock Text="{Binding CurvePreviewText}" Style="{DynamicResource HintText}"
                                   VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 温度曲线 -->
            <TextBlock Text="温度曲线" Style="{DynamicResource SectionTitleText}" Margin="0,24,0,10" />
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="曲线" Style="{DynamicResource MetricLabelText}" VerticalAlignment="Center" />
                            <ComboBox Style="{DynamicResource ModernComboBox}" Width="240" Margin="10,0,0,0"
                                      ItemsSource="{Binding Curves}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding ActiveCurve, Mode=TwoWay}" />
                            <TextBlock Text="{Binding CurveCountText}" Style="{DynamicResource HintText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="新建" Command="{Binding NewCurveCommand}"
                                    Style="{DynamicResource SecondaryButton}" MinWidth="76" />
                            <Button Content="删除" Command="{Binding DeleteCurveCommand}"
                                    Style="{DynamicResource SecondaryButton}" MinWidth="76" Margin="8,0,0,0" />
                            <Button Content="保存曲线" Command="{Binding SaveCurveCommand}"
                                    Style="{DynamicResource PrimaryButton}" MinWidth="96" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <ctl:FanCurveEditor x:Name="CurveEditor" Height="280" Margin="0,12,0,0"
                                        Curve="{Binding ActiveCurve, Mode=TwoWay}"
                                        CurrentTemperature="{Binding CurrentCpuTemperature}" />
                    <TextBlock Text="左键拖动节点 · 双击空白添加节点 · 右键节点删除。节点会被夹紧在 20%–100% 与 30–100℃，至少保留两个节点。"
                               Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />

                    <UniformGrid Columns="4" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="曲线名称" Style="{DynamicResource MetricLabelText}" />
                            <TextBox Style="{DynamicResource ModernTextBox}" Margin="0,6,0,0"
                                     Text="{Binding CurveName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="回滞温度" Style="{DynamicResource MetricLabelText}" />
                                <TextBlock Text="{Binding HysteresisCelsius}" Style="{DynamicResource HintText}" Margin="6,0,0,0" />
                                <TextBlock Text="℃" Style="{DynamicResource HintText}" />
                            </StackPanel>
                            <Slider Style="{DynamicResource ModernSlider}" Minimum="0" Maximum="15"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding HysteresisCelsius, Mode=TwoWay}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="响应延迟" Style="{DynamicResource MetricLabelText}" />
                                <TextBlock Text="{Binding ResponseDelaySeconds}" Style="{DynamicResource HintText}" Margin="6,0,0,0" />
                                <TextBlock Text="秒" Style="{DynamicResource HintText}" />
                            </StackPanel>
                            <Slider Style="{DynamicResource ModernSlider}" Minimum="1" Maximum="60"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding ResponseDelaySeconds, Mode=TwoWay}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="平滑" Style="{DynamicResource MetricLabelText}" />
                            <CheckBox Style="{DynamicResource ModernToggle}" Content="转速渐变过渡"
                                      IsChecked="{Binding Smoothing, Mode=TwoWay}" Margin="0,10,0,0" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="应用曲线" Command="{Binding ApplyCurveCommand}"
                                Style="{DynamicResource PrimaryButton}" MinWidth="120"
                                IsEnabled="{Binding CanApplyCurve}" />
                        <TextBlock Text="应用曲线需要能读到 CPU 温度，且风扇接口真实可用；否则会明确报错而不是假装成功。"
                                   Style="{DynamicResource HintText}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="560" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 操作结果 -->
            <Border Style="{DynamicResource PanelStyle}" Margin="0,12,0,0"
                    Visibility="{Binding HasApplyMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ApplyMessage}" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{Binding ApplyState, Converter={StaticResource StateToBrush}}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
