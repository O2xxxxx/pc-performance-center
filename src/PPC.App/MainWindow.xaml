<Window x:Class="Ppc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Ppc.App.Infrastructure"
        Title="PC Performance Center" Height="820" Width="1280" MinHeight="640" MinWidth="1040"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg.Window}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        Icon="pack://application:,,,/Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <infra:PathGeometryConverter x:Key="PathGeometry" />

        <!-- macOS 红绿灯 -->
        <Style x:Key="TrafficLight" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#7A000000" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="#26000000" StrokeThickness="1" />
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" Opacity="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Bold" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 侧栏 ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Bg.Sidebar}"
                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 红绿灯 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,14,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Close}"
                            Content="&#x2715;" Click="Close_Click" ToolTip="关闭（最小化到托盘）" />
                    <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Minimize}"
                            Content="&#x2212;" Click="Minimize_Click" ToolTip="最小化" />
                    <Button Style="{StaticResource TrafficLight}" Background="{DynamicResource Traffic.Maximize}"
                            Content="&#x2B;" Click="Maximize_Click" ToolTip="最大化 / 还原" />
                </StackPanel>

                <!-- 应用标识 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="18,20,16,18">
                    <Border Width="32" Height="32" CornerRadius="9" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A84FF" Offset="0" />
                                <GradientStop Color="#5E5CE6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="PC" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="性能中心" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="{Binding Device.DisplayName, FallbackValue=正在识别设备}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                   Foreground="{DynamicResource Text.Tertiary}" />
                    </StackPanel>
                </StackPanel>

                <!-- 导航 -->
                <ListBox Grid.Row="2" x:Name="NavList" ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Margin="0,2,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{DynamicResource NavItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Height="30">
                                <Path Data="{Binding Icon, Converter={StaticResource PathGeometry}}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部状态 -->
                <StackPanel Grid.Row="3" Margin="16,10,16,14">
                    <Border Background="{DynamicResource Bg.SurfaceAlt}" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.Secondary}" />
                            <TextBlock Text="{Binding AppVersion, StringFormat=版本 {0}}" Margin="0,3,0,0"
                                       FontSize="10.5" Foreground="{DynamicResource Text.Tertiary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 内容区 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="86" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Margin="28,0,28,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{DynamicResource PageTitleText}" />
                    <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{DynamicResource HintText}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="28,0,24,18" />
        </Grid>
    </Grid>
</Window>
